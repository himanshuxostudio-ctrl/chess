# ---- Server (server/index.ts) ----
# Port the HTTP + WebSocket server listens on (most hosts inject this automatically).
PORT=8787
# Directory containing the built client (output of `npm run build`).
STATIC_DIR=dist
# Where active rooms are persisted so games survive a server restart. Use a persistent disk path in production.
DATA_FILE=data/rooms.json

# ---- Client (Vite, baked in at build time) ----
# Only needed when the client is hosted separately from the server (e.g. client on Vercel,
# server on Render). Leave unset when the server also serves the client (recommended).
# VITE_WS_URL=wss://your-game-server.example.com/ws
